#!/usr/bin/env bash
# Opens a file at a line in the Neovim that's working on it, and switches to
# that Neovim's pane. iTerm2 runs this when you Cmd-click a path such as
# src/app.tsx:42:7 (Semantic History in config/iterm2/profiles.json):
#
#   nvim-open <file> [line] [column] [folder the path was printed in]
#
# Without a Neovim for that project it starts one in a new iTerm2 tab. It
# controls iTerm2 with iTerm2's own it2 command, which needs iTerm2's Python API
# turned on (setup.sh turns it on, or tells you how).
set -euo pipefail

file=${1:?usage: nvim-open <file> [line] [column] [folder]}
line=${2:-} col=${3:-} dir=${4:-$PWD}
# iTerm2 starts this outside your shell, so Homebrew isn't on PATH yet, and it2
# may not be either
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
it2=$(command -v it2 || echo /Applications/iTerm.app/Contents/Resources/utilities/it2)
[[ "$line" =~ ^[0-9]+$ ]] || line=0
[[ "$col" =~ ^[0-9]+$ ]] || col=0
[[ "$file" == /* ]] || file="$dir/$file"
# Neovim reports its folder with symlinks resolved (/tmp is /private/tmp)
if parent=$(cd "$(dirname "$file")" 2>/dev/null && pwd -P); then
  file="$parent/$(basename "$file")"
fi
tmp=${TMPDIR:-$(getconf DARWIN_USER_TEMP_DIR)}
user=${USER:-$(id -un)}

# As a Vimscript string: single quotes, with ' doubled. The quote is in a
# variable because macOS's bash 3.2 keeps the backslashes of \' in ${x//\'/...}
vim_string() {
  local q="'"
  printf "'%s'" "${1//$q/$q$q}"
}
quoted=$(vim_string "$file")

# Every running Neovim listens on a socket; pick the one that has the file open,
# else the one whose folder holds it (the deepest folder wins)
best='' best_score=0 best_session=''
for sock in "${tmp%/}/nvim.$user"/*/nvim.*.0; do
  [[ -S "$sock" ]] || continue
  # A Neovim that's busy or gone mustn't hold this up
  info="$(perl -e 'alarm 2; exec @ARGV' nvim --server "$sock" --remote-expr \
    "bufloaded($quoted) . ' ' . (empty(\$ITERM_SESSION_ID) ? '-' : \$ITERM_SESSION_ID) . ' ' . getcwd()" \
    2>/dev/null)" || continue
  loaded=${info%% *} rest=${info#* }
  session=${rest%% *} cwd=${rest#* }
  score=0
  if [[ "$loaded" == 1 ]]; then
    score=100000
  elif [[ "$file" == "$cwd"/* ]]; then
    score=${#cwd}
  fi
  if ((score > best_score)); then
    best=$sock best_score=$score best_session=$session
  fi
done

if [[ -n "$best" ]]; then
  # Still switch panes if that Neovim runs without this config
  nvim --server "$best" --remote-expr "v:lua.require'config.iterm'.open($quoted, $line, $col)" >/dev/null || true
  # ITERM_SESSION_ID is w0t1p0:<unique ID>, and it2 session focus wants only the
  # unique ID. The file is open either way, so if its pane can't come to the
  # front, Neovim says why
  if [[ "$best_session" == *:* ]] && ! why="$("$it2" session focus "${best_session#*:}" 2>&1 >/dev/null)"; then
    if [[ "$why" == *"Python API"* ]]; then
      why="its Python API isn't running. In iTerm2's Settings › General › Magic, tick Enable Python API,"
      why+=" or untick it and tick it again if it's ticked already"
    else
      why=${why%%$'\n'*}
    fi
    why="⌘-click couldn't bring this pane to the front in iTerm2: ${why#Error: }"
    nvim --server "$best" --remote-expr "v:lua.vim.notify($(vim_string "$why"), 3)" >/dev/null 2>&1 || true
  fi
  exit 0
fi

target=''
((line > 0)) && target=$(printf %q "+call cursor($line, $col)")
command="cd $(printf %q "$dir") && nvim $target $(printf %q "$file")"
# A new tab in the window you clicked in, or a new window if there's none. Either
# way the command is typed into a shell, so your shell's setup loads first
"$it2" app activate >/dev/null 2>&1 || true
if ! "$it2" tab new --command "$command" >/dev/null 2>&1; then
  "$it2" window new >/dev/null
  "$it2" session run "$command" >/dev/null
fi
